# MDelta Meetings — конфигурация
# Скопируйте в .env (dev) или %LOCALAPPDATA%\MDelta Meetings\.env (установленное приложение).
# Все настройки также доступны через диалог ⚙ в приложении.

# ══ Обработка и саммаризация (LLM) ═══════════════════════════════════════════
# Провайдер: inference (OpenAI-совместимый) ИЛИ mdelta (MDelta API)
# LLM_PROVIDER=inference

# --- Вариант 1: Inference (OpenAI / LM Studio / Ollama / vLLM) ---
# OPENAI_API_KEY=sk-proj-...
# Base URL для локальных серверов (пусто = облачный OpenAI):
#   LM Studio Runtime API: OPENAI_API_BASE=http://127.0.0.1:1234/api/v1
#   LM Studio (OpenAI-совместимый): OPENAI_API_BASE=http://127.0.0.1:1234/v1
#   Ollama:                OPENAI_API_BASE=http://127.0.0.1:11434/v1
# OPENAI_API_BASE=
# CHATGPT_MODEL=gpt-4o

# --- Вариант 2: MDelta API (RAG-платформа, JWT-авторизация) ---
# LLM_PROVIDER=mdelta
# MDELTA_API_URL=https://mdrag.example.com
# MDELTA_USERNAME=user
# MDELTA_PASSWORD=secret

# ══ Распознавание речи (Whisper) ═════════════════════════════════════════════
# Источник: local (WhisperNet GPU / faster-whisper CPU) ИЛИ remote (сервер)
# WHISPER_MODE=local

# Локальная модель: tiny, base, small, medium, large-v3-turbo, large-v3
# WHISPER_MODEL=base

# Удалённый Whisper-сервер (OpenAI-совместимый /v1/audio/transcriptions):
#   LM Studio:              http://127.0.0.1:1234/v1
#   speaches / fw-server:   http://server:8000/v1
# WHISPER_REMOTE_URL=
# WHISPER_REMOTE_KEY=
# WHISPER_REMOTE_MODEL=whisper-1

# Язык распознавания (ru / en / auto)
# WHISPER_LANGUAGE=ru
