# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# Optional: Custom API Base URL for OpenAI-compatible servers
# LM Studio (local):  OPENAI_API_BASE=http://127.0.0.1:1234/v1
# Ollama (local):     OPENAI_API_BASE=http://127.0.0.1:11434/v1
# Leave empty to use standard OpenAI API
# OPENAI_API_BASE=

# Optional: LLM Model (default: gpt-4o)
# For LM Studio use the model name shown in the LM Studio UI, e.g.:
# CHATGPT_MODEL=llama-3.2-3b-instruct
# CHATGPT_MODEL=gpt-4o

# Optional: Whisper Model (default: base)
# Sizes: tiny, base, small, medium, large (larger = more accurate, slower)
# WHISPER_MODEL=base

# Optional: Recognition language (default: ru)
# WHISPER_LANGUAGE=ru
