# Виртуальное окружение
venv/
env/
ENV/

# Зависимости Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Временные файлы данных
data/temp/*
!data/temp/.gitkeep
*.wav
*.mp3
*.ogg

# Конфиденциальные данные
.env
*.env
.env.local
.env.development
.env.test
.env.production

# Логи и базы данных
*.log
*.sqlite
*.db

# Файлы IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Специфичные для проекта файлы
api_keys.json
config_local.py

# Артефакты сборки
*.dll
*.dylib
*.out
# installer: игнорируем скачанные бинарники и готовый .exe, но не скрипты
installer/bundled/ffmpeg/*.exe
dist/*.exe
# install_deps.log генерируется на машине пользователя
install_deps.log

# WhisperService: бинари публикуются в data/whisper_service, не в git
data/whisper_service/
# Кроме этого разрешаем .gitkeep для папки
!data/whisper_service/.gitkeep

# .NET build артефакты
whisper_service/bin/
whisper_service/obj/

# Кэш и временные файлы
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Тестовые записи
test_recording_*.wav
debug_recording_*.wav

# Сохранённые разговоры и саммари (генерируются пользователем)
conversation_*.json
summary_*.json
summary_*.txt

# Кэш моделей PyTorch/Silero (скачиваются автоматически)
# torch/hub кэш хранится в ~/.cache/torch/hub/ — не в репозитории
